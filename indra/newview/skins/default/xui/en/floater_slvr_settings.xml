     left="12"
     name="performance_preset"
     top="394"
     width="403" />
    <check_box
     control_name="SLVRSmoothTurn"
     follows="left|top"
     height="16"
     label="Smooth turning (off: in steps)"
     layout="topleft"
     left="434"
     name="smooth_turn"
     top="34"
     width="403" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="434"
     name="snap_angle_label"
     top="64"
     width="170">
        Turn step:
    </text>
