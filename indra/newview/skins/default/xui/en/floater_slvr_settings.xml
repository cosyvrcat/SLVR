<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- SLVR: labels are put into the SLVR language by llvrlanguage.cpp; these are the fallback. -->
<floater
 legacy_header_height="18"
 can_resize="false"
 height="282"
 layout="topleft"
 name="slvr_settings"
 single_instance="true"
 save_rect="true"
 title="SLVR Settings"
 width="420">
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="12"
     name="language_label"
     top="32"
     width="170">
        SLVR language:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="185"
     name="language"
     top="28"
     width="220" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="12"
     name="keyboard_label"
     top="64"
     width="170">
        Keyboard layout:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="185"
     name="keyboard_layout"
     top="60"
     width="220" />
    <check_box
     control_name="SLVRWordSuggestions"
     follows="left|top"
     height="16"
     label="Word suggestions and next-word prediction"
     layout="topleft"
     left="12"
     name="word_suggestions"
     top="98"
     width="395" />
    <check_box
     control_name="SLVRMessageDotPrivateOnly"
     follows="left|top"
     height="16"
     label="Message dot only for private chats"
     layout="topleft"
     left="12"
     name="message_dot_private"
     top="124"
     width="395" />
    <check_box
     control_name="SLVRSmoothTurn"
     follows="left|top"
     height="16"
     label="Smooth turning (off: 30 degree steps)"
     layout="topleft"
     left="12"
     name="smooth_turn"
     top="150"
     width="395" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="12"
     name="vignette_label"
     top="182"
     width="170">
        Comfort vignette:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="185"
     name="vignette"
     top="178"
     width="220" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="12"
     name="laser_colour_label"
     top="214"
     width="170">
        Laser colour:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="185"
     name="laser_colour"
     top="210"
     width="220" />
    <slider
     control_name="SLVRLaserOpacity"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.05"
     label="Laser opacity:"
     label_width="170"
     layout="topleft"
     left="12"
     max_val="1"
     min_val="0.1"
     name="laser_opacity"
     top="246"
     width="393" />
</floater>
