     control_name="SLVRSmoothTurnSpeed"
     decimal_digits="0"
     follows="left|top"
     height="16"
     increment="10"
     label="Smooth turn speed:"
     label_width="170"
     layout="topleft"
     left="434"
     max_val="240"
     min_val="10"
     name="turn_speed"
     top="94"
     width="401" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="434"
     name="vignette_label"
     top="124"
     width="170">
        Comfort vignette:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="607"
     name="vignette"
     top="120"
     width="230" />
    <check_box
     control_name="SLVRBlink"
     follows="left|top"
     height="16"
     label="Blink over snap turns and teleports"
     layout="topleft"
     left="434"
     name="blink"
     top="154"
     width="403" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="434"
     name="walk_direction_label"
     top="184"
     width="170">
        Walk towards:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="607"
     name="walk_direction"
     top="180"
     width="230" />
    <check_box
     control_name="SLVRLeftHanded"
     follows="left|top"
     height="16"
     label="Left-handed (swap the controllers)"
     layout="topleft"
     left="434"
     name="left_handed"
     top="214"
     width="403" />
    <check_box
     control_name="SLVRIgnoreScriptCamera"
     follows="left|top"
     height="16"
     label="Keep my eyes&apos; view when scripts move the camera"
     layout="topleft"
     left="434"
     name="ignore_script_camera"
     top="244"
     width="403" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="434"
     name="eye_height_label"
     top="274"
     width="170">
        Eye height:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="607"
     name="eye_height"
     top="270"
     width="230" />
    <slider
     control_name="SLVRBodyHeight"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.01"
     label="My height (m):"
     label_width="170"
     layout="topleft"
     left="434"
     max_val="2.3"
     min_val="1"
     name="body_height"
     top="304"
     width="401" />
    <button
     follows="left|top"
     height="23"
     label="Measure my height (stand up straight)"
     layout="topleft"
     left="434"
     name="measure_height"
     top="330"
     width="403" />
</floater>
