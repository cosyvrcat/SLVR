<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- SLVR: labels are put into the SLVR language by llvrlanguage.cpp; these are the fallback. -->
<floater
 legacy_header_height="18"
 can_resize="false"
 height="428"
 layout="topleft"
 name="slvr_settings"
 single_instance="true"
 save_rect="true"
 title="SLVR Settings"
 width="849">
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="12"
     name="language_label"
     top="34"
     width="170">
        SLVR language:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="185"
     name="language"
     top="30"
     width="230" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="12"
     name="keyboard_label"
     top="64"
     width="170">
        Keyboard layout:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="185"
     name="keyboard_layout"
     top="60"
     width="230" />
    <check_box
     control_name="SLVRWordSuggestions"
     follows="left|top"
     height="16"
     label="Word suggestions and next-word prediction"
     layout="topleft"
     left="12"
     name="word_suggestions"
     top="94"
     width="403" />
    <button
     follows="left|top"
     height="23"
     label="Forget the learned words"
     layout="topleft"
     left="12"
     name="forget_words"
     top="120"
     width="403" />
    <check_box
     control_name="SLVRSwipeTyping"
     follows="left|top"
     height="16"
     label="Swipe typing (glide over the letters)"
     layout="topleft"
     left="12"
     name="swipe_typing"
     top="154"
     width="403" />
    <check_box
     control_name="SLVRMessageDotPrivateOnly"
     follows="left|top"
     height="16"
     label="Message dot only for private chats"
     layout="topleft"
     left="12"
     name="message_dot_private"
     top="184"
     width="403" />
    <text
     follows="left|top"
     height="16"
     layout="topleft"
     left="12"
     name="laser_colour_label"
     top="214"
     width="170">
        Laser colour:
    </text>
    <combo_box
     follows="left|top"
     height="23"
     layout="topleft"
     left="185"
     name="laser_colour"
     top="210"
     width="230" />
    <slider
     control_name="SLVRLaserOpacity"
     decimal_digits="2"
     follows="left|top"
     height="16"
     increment="0.05"
     label="Laser opacity:"
     label_width="170"
     layout="topleft"
     left="12"
     max_val="1"
     min_val="0.1"
     name="laser_opacity"
     top="244"
     width="401" />
    <check_box
     control_name="SLVRHaptics"
     follows="left|top"
     height="16"
     label="Controller vibration"
     layout="topleft"
     left="12"
     name="haptics"
     top="274"
     width="403" />
    <check_box
     control_name="SLVRShowControllers"
     follows="left|top"
     height="16"
     label="Show the controllers (off: lasers only)"
     layout="topleft"
     left="12"
     name="show_controllers"
     top="304"
     width="403" />
    <check_box
     control_name="SLVRCurvedPanel"
     follows="left|top"
     height="16"
     label="Curved panel"
     layout="topleft"
     left="12"
     name="curved_panel"
     top="334"
     width="403" />
    <check_box
     control_name="SLVRPanelFollow"
     follows="left|top"
     height="16"
     label="Panel follows my view"
     layout="topleft"
     left="12"
     name="panel_follow"
     top="364"
     width="403" />
    <check_box
     control_name="SLVRVRGraphics"
